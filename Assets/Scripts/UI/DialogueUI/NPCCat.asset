  TalkerName: Cat
  dialogueID: 1
  dialogueLines:
  - "\uC548\uB155 \uB108\uB294 \uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC774\uB2E4"
  - "\uC624\uB298...? \uC624\uB298 \uC5EC\uAE30 \uC654\uB2E4\uACE0? "
  - "\uB0B4\uAC00 \uBB34\uC11C\uC6B4 \uC774\uC57C\uAE30 \uD574\uC904\uAE4C? \uC774\uB54C\uAE4C\uC9C0
    \uC5EC\uAE30 \uC815\uB9D0 \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774 \uC654\uC5C8\uB294\uB370"
  - "\uB2E8 \uD55C\uBA85\uB3C4 10\uC77C \uC774\uC0C1 \uBC84\uD2F0\uC9C0 \uBABB\uD588\uC5B4!"
  - "\uC5EC\uAE30 \uC9C0\uC5ED\uC740 \uC628\uB3C4 \uBCC0\uD654\uB3C4 \uC2EC\uD558\uACE0
    \uAC08\uB4F1\uC744 \uD574\uACB0\uD560 \uBC29\uBC95\uB3C4 \uC2A4\uC2A4\uB85C \uCC3E\uC544\uC57C\uD574"
  - "\uADF8\uB7FC... \uD654\uC774\uD305\uC774\uC57C?!"
  choiceButtonText:
  - "\uC5B4...? \uC54C\uACA0\uC5B4 \uD55C\uBC88 \uB178\uB825\uD574\uBCF4\uC9C0 \uBB50"
  - "(\uB3C4\uB9DD\uAC04\uB2E4)"
