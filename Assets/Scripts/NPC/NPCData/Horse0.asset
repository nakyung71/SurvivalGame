  TalkerName: Horse
  dialogueID: 1
  dialogueLines:
  - "\uD788\uD788\uD79D! \uC548\uB155? \uB108\uB294 \uCC98\uC74C\uBCF8\uB2E4 \uD478\uB974\uB974"
  - "\uC624\uB298...? \uD788\uD788\uD79D..? \uC624\uB298 \uC5EC\uAE30 \uC654\uB2E4
    \uD478\uB974\uB974? "
  - "\uD788\uD788\uD79D! \uB0B4\uAC00 \uBB34\uC11C\uC6B4 \uC774\uC57C\uAE30 \uD574\uC904\uAE4C?
    \uC774\uB54C\uAE4C\uC9C0 \uC5EC\uAE30 \uC815\uB9D0 \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774
    \uC654\uC5C8\uB294\uB370 \uD478\uB974\uB974"
  - "\uB2E8! \uD788\uD788\uD79D! \uD55C\uBA85\uB3C4 10\uC77C \uC774\uC0C1 \uBC84\uD2F0\uC9C0
    \uBABB\uD588 \uD478\uB974\uB974!"
  - "\uD788\uD788\uD79D! \uC5EC\uAE30 \uC9C0\uC5ED\uC740 \uC628\uB3C4 \uBCC0\uD654\uB3C4
    \uC2EC\uD558\uACE0 \uAC08\uB4F1\uC744 \uD574\uACB0\uD560 \uBC29\uBC95\uB3C4 \uC2A4\uC2A4\uB85C
    \uCC3E\uC544\uC57C\uD574 \uD478\uB974\uB974"
  - "\uD788\uD788\uD79D.. \uADF8\uB7FC... \uD654\uC774\uD305 \uD478\uB974\uB974?!"
  - "\uC544 \uADF8 \uAC00\uAE30 \uC804\uC5D0 \uD2B9\uBCC4\uD788 \"\uB098\uBB34 3\uAC1C\"
    \uB9CC \uAC00\uC838\uB2E4\uC8FC\uBA74  \uC9D1\uC744 \uC9C0\uC5B4\uC904\uAC8C"
  - "\uCC98\uC74C \uBC29\uBB38\uD588\uC73C\uB2C8 \uD2B9\uBCC4\uD788 \uC8FC\uB294
    \uC120\uBB3C(?) \uC774\uC57C \uD788\uD788\uD79D!"
  choiceButtonText:
  - "\uC5B4...? \uC54C\uACA0\uC5B4 (\uB098\uBB34 3\uAC1C\uB97C \uAC00\uC838\uC624\uC790)"
  - "(\uB3C4\uB9DD\uAC04\uB2E4)"
